---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';

const recentPosts = (await getPosts()).slice(0, 5);
---

<Layout>
  <section class="py-8">
    <h1 class="text-2xl font-bold tracking-tight">Hi, I'm Kevin.</h1>
    <!-- TODO(kevin): replace with your real intro -->
    <p class="mt-4 text-gray-700 dark:text-gray-300">
      I'm a software engineer building for the web. I write here about software
      engineering — and occasionally about whatever else earns a spot.
    </p>
    <p class="mt-2 text-gray-700 dark:text-gray-300">
      More about me on the <a href="/about" class="underline">about page</a>.
    </p>
  </section>
  <section class="py-8">
    <h2 class="mb-6 text-lg font-semibold tracking-tight">Recent writing</h2>
    <PostList posts={recentPosts} />
    {
      recentPosts.length > 0 && (
        <p class="mt-8">
          <a href="/blog" class="text-sm underline">
            All posts →
          </a>
        </p>
      )
    }
  </section>
</Layout>
